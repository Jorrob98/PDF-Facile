{
  "name": "docfix-desktop",
  "version": "1.9.34",
  "description": "DocFix Desktop by Jorrob",
  "author": "Jorrob",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-vendor": "node prepare-vendor.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "test:stability": "node qa-stability-guard.cjs",
    "test:docfix:qa": "node qa-card-orientation.cjs && node qa-a4-preserve.cjs && node qa-pair-proof.cjs && node qa-pair-uncertain-preview.cjs && node qa-pair-roi-retry.cjs && node qa-single-final-gate.cjs && node qa-export-safety.cjs && node qa-onepass-physical.cjs && node qa-glare-mask.cjs && node qa-low-contrast-pair.cjs && node qa-adversarial-diagnostics.cjs",
    "test:docfix:release": "npm run test:docfix:qa && node qa-adversarial-diagnostics.cjs --strict"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "pdfjs-dist": "4.10.38",
    "pdf-lib": "1.17.1",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0"
  },
  "build": {
    "appId": "it.jorrob.docfix",
    "productName": "DocFix",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "ocr-cloud-main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "DocFix_Setup_1.9.34.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocFix",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
